{
  "schemaVersion": 1,
  "id": "iron-jetpacks",
  "version": "${version}",
  "name": "Iron Jetpacks",
  "description": "A fully customizable FE powered jetpacks mod!",
  "authors": [
    "BlakeBr0",
    "shedaniel",
    "Anomz"
  ],
  "license": "MIT",
  "icon": "assets/iron-jetpacks/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.blakebr0.ironjetpacks.IronJetpacks"
    ],
    "kubejs-set-recipes": [
      "com.blakebr0.ironjetpacks.compat.kubejs.KubeJSCompat"
    ]
  },
  "accessWidener": "iron-jetpacks.accesswidener",
  "mixins": [
    "iron-jetpacks.mixin.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.0",
    "fabric-api": "*",
    "cloth-config": "*",
    "minecraft": ">=26.1"
  }
}